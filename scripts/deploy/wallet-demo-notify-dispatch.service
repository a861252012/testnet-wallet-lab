[Unit]
Description=Check latest signed wallet release after notification
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/rm -f /run/wallet-demo-notify/trigger
ExecStart=/usr/local/sbin/wallet-demo-poll
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/testnet-wallet-lab /run/wallet-demo-notify
