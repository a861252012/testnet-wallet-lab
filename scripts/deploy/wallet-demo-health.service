[Unit]
Description=Record bounded wallet host and tunnel diagnostics
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/wallet-demo-record-health
TimeoutStartSec=55
UMask=0077
LogsDirectory=wallet-demo
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=64M
CPUQuota=10%
