# Optional: copy to .env. Docker Compose loads .env automatically.
# Do not commit provider credentials. This RPC is used for Sepolia reads and signed transaction broadcasts.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PORT=8090

# Optional. Leave empty for the localhost demo (no login).
# Set a token to enable the browser login page or CLI Basic authentication.
# Generate locally, for example: openssl rand -hex 32
WALLET_ACCESS_TOKEN=

# Optional fixed HTTPS origin for public read-only deployments; wallet operations require the owner access token.
# No trailing slash. Forwarded headers are deliberately not trusted.
PUBLIC_ORIGIN=

# Optional comma-separated fallback RPC endpoints (Sepolia only, maximum three).
SEPOLIA_RPC_FALLBACK_URLS=

ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_FALLBACK_URLS=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_FALLBACK_URLS=

OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
OP_SEPOLIA_RPC_FALLBACK_URLS=

SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Polygon Amoy: native fee currency is POL, never Ethereum ETH.
POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_AMOY_RPC_FALLBACK_URLS=
# TRON Shasta only. Optional provider API key; never a wallet signing key.
TRON_SHASTA_RPC_URL=https://api.shasta.trongrid.io
TRON_SHASTA_API_KEY=

# Optional local testnet dispenser: owner-only JSON {accountId, password}. Never commit credentials.
TEST_FAUCET_CONFIG=

# Optional: deployed ETHVault address on Ethereum Sepolia. Empty disables the panel.
SEPOLIA_VAULT_ADDRESS=
# Optional PaymentEscrow deployed with Circle Sepolia USDC; disabled when empty.
SEPOLIA_ESCROW_ADDRESS=
