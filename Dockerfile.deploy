FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
ARG APP_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${APP_VERSION}" -o /out/wallet ./cmd/testnet-wallet-lab

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/wallet /wallet
USER 10001:10001
ENV HTTP_HOST=0.0.0.0 PORT=8090 WALLET_DIR=/data/wallet
ARG APP_VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/a861252012/testnet-wallet-lab" \
      org.opencontainers.image.revision="${APP_VERSION}"
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 CMD ["/wallet", "--healthcheck"]
ENTRYPOINT ["/wallet"]
